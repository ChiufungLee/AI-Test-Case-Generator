# AI 智能测试系统配置示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交真实密钥。

# ---- 运行环境 ----
# development / test / production；production 下必须设置 SESSION_SECRET_KEY，否则启动报错；
# 其它取值（如 prod、带空格）会直接启动失败——生产保护依赖该值精确匹配
APP_ENV=development

# ---- 会话 ----
# 生产环境必须设置强随机值
SESSION_SECRET_KEY=

# ---- 数据库 ----
# 设置 DATABASE_URL 时优先生效（如 sqlite:///./fast_test.db）；
# 留空时使用下方 MySQL 配置拼装连接串
# DATABASE_URL=
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aitest_rag

# ---- LLM（DeepSeek）----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.7
# 思考模型（deepseek-v4 系列）的 reasoning token 计入 max_tokens，预算需容纳完整回复
LLM_MAX_TOKENS=16384
LLM_TIMEOUT_CONNECT=10
LLM_TIMEOUT_READ=120
LLM_TIMEOUT_WRITE=30
LLM_TIMEOUT_POOL=10
LLM_MAX_RETRIES=2
# 思考模式开关：默认 false（非思考模式，响应快且 temperature 生效）；
# true 时 reasoning token 计入 max_tokens 且 temperature 不生效
LLM_ENABLE_THINKING=false

# ---- 向量 Embedding（阿里云百炼兼容接口）----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENCODING_FORMAT=float

# ---- 检索 ----
RETRIEVER_TOP_K=5
RETRIEVER_CANDIDATE_K=10
# 距离阈值过滤：数值含义依赖 CHROMA_DISTANCE_METRIC（cosine 距离范围 [0,2]）
# RETRIEVER_ENABLE_DISTANCE_FILTER=true
# RETRIEVER_DISTANCE_THRESHOLD=1.2
# Chroma 集合度量：cosine / l2（仅建集合时生效，对已存在集合不生效）
CHROMA_DISTANCE_METRIC=cosine

# ---- 工作流 ----
# 结构化输出 max_tokens：需容纳思考模型的 reasoning + 完整用例集 JSON
WORKFLOW_LLM_MAX_TOKENS=16384

# ---- 接口测试 ----
# 单条用例请求超时（秒）
API_TEST_TIMEOUT=15
# OpenAPI 文档 URL 导入 / 同步的远端拉取超时（秒）
API_SPEC_IMPORT_TIMEOUT=15

# ---- 存储路径 ----
RAG_DB_PATH=./chroma_db
WORKFLOW_CHECKPOINT_DB_PATH=./data/langgraph_checkpoints.db
UPLOAD_DIR=./uploads
TEMP_UPLOAD_DIR=./temp_uploads
